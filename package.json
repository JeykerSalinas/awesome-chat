{
  "name": "lovely-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview --config frontend/vite.config.ts",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --config-file frontend/cypress.config.ts --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --config frontend/vite.config.ts --port 4173' http://localhost:4173 'cypress open --config-file frontend/cypress.config.ts --e2e'",
    "test:unit": "cypress run --config-file frontend/cypress.config.ts --component",
    "test:unit:dev": "cypress open --config-file frontend/cypress.config.ts --component",
    "build-only": "vite build --config frontend/vite.config.ts",
    "type-check": "vue-tsc --build tsconfig.json",
    "format": "prettier --write frontend/src/ frontend/*.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.1.45",
    "@langchain/ollama": "^1.2.7",
    "@langchain/tavily": "^1.2.0",
    "axios": "^1.12.1",
    "deepagents": "^1.10.0",
    "langchain": "^1.4.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "cypress": "^15.5.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "3.6.2",
    "sass-embedded": "^1.93.2",
    "start-server-and-test": "^2.1.2",
    "typescript": "~5.9.0",
    "vite": "npm:rolldown-vite@latest",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vue-tsc": "^3.1.1"
  }
}
